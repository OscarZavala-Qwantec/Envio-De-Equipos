rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /envioClientes/{document} {
      allow read, write: if true;
    }
    match /envioRegistros/{document} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
